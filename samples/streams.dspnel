fn range(
            start: T   = 0,
             step: T   = 1,
    state current: T   = start,
    out         y: <T>,
) {
    y.push(current);
    current += step;
}

fn cosine(
          sample_rate: samprate,
                 freq: freq,
        initial_phase: phase    = 0,                 
            amplitude: f64,                 
               offset: f64      = 0,
    out             y: <f64>,
) {
    y = offset + amplitude * signals.samples(sample_rate, freq, initial_phase).re();
}
