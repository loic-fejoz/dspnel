kernel delay_line(
    max_delay: usize,
    in x: <f32>,
    in delay: <usize>,
    out y: <f32>,
) {
    @align(64)
    state buffer: circular_buffer<f32, max_delay>;
    
    // Write input to buffer
    buffer.push(x);
    
    // Read delayed sample
    y = buffer.get(delay);
}

let simple_echo = delay_line(44100, delay: 11025); // 250ms delay at 44.1kHz
